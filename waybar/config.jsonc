
{
    "layer": "top",
    "position": "top",
    "height": 42,
    "spacing": 8,

    "modules-left": [
        "custom/workspaces"
    ],

    "modules-center": [
        "cpu",
        "memory",
        "disk"
    ],

    "modules-right": [
        "mpris",
        "wireplumber",
        "clock",
        "tray"
    ],

    "custom/workspaces": {
        "format": "󰍹 KDE",
        "tooltip": false
    },

    "cpu": {
        "format": "󰍛 {usage}%",
        "tooltip": false,
        "interval": 2
    },

    "memory": {
        "format": "󰘚 {percentage}%",
        "tooltip": true,
        "interval": 2
    },

    "disk": {
        "path": "/",
        "format": "󰋊 {free}",
        "interval": 30
    },

    "mpris": {
        "format": "󰐊 {artist} - {title}",
        "format-paused": "󰏤 {artist} - {title}",
        "max-length": 35,
        "tooltip": true,
        "player": "spotify"
    },

    "wireplumber": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰖁 Muted",
        "on-click": "pavucontrol"
    },

    "clock": {
        "format": "󰥔 {:%H:%M}",
        "format-alt": "{:%Y-%m-%d}"
    },

    "tray": {
        "spacing": 8
    }
}
